{
    "name": "ship-again/purl",
    "type": "library",
    "description": "URL Manipulation for PHP 7.2+",
    "keywords": ["url", "manipulation"],
    "homepage": "https://github.com/ship-again/purl",
    "license": "MIT",
    "authors": [
        {"name": "Jonathan H. Wage", "email": "jonwage@gmail.com"},
        {"name": "Sergei Lysogor", "email": "me@mstrict.net"}
    ],
    "autoload": {
        "psr-4": {"Purl\\": "src/Purl"}
    },
    "autoload-dev": {
        "psr-4": {"Purl\\Test\\": "tests/Purl/Test"}
    },
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^7.2 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5.52 || ^9.6.33 || ^10.5.62 || ^11.5.50 || ^12.5.22 || ^13.1.6"
    },
    "replace": {
        "jwage/purl": "self.version"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.1.x-dev"
        }
    }
}
